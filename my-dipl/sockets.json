{
  "$schema": "https://json-schema.org",
  "title": "DiplomacyWebSocketPayload",
  "description": "Standard real-time messaging schema for full duplex game synchronization.",
  "type": "object",
  "required": ["message_id", "timestamp", "session_token", "game_id", "event_type", "payload"],
  "properties": {
    "message_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique tracking identifier to enable server ack responses and prevent message duplication."
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 millisecond-accurate timestamp used to handle network latency variations."
    },
    "session_token": {
      "type": "string",
      "description": "Cryptographically signed JWT to authorize the connection and authenticate player ID."
    },
    "game_id": {
      "type": "string",
      "format": "uuid",
      "description": "Target multiplayer lobby or state instance identifier."
    },
    "event_type": {
      "type": "string",
      "enum": [
        "CLIENT_ORDER_SUBMIT",
        "SERVER_ORDER_ACK",
        "SERVER_STATE_SYNC",
        "CLIENT_CHAT_SEND",
        "SERVER_CHAT_BROADCAST",
        "SERVER_TIMER_TICK"
      ]
    },
    "payload": {
      "type": "object",
      "description": "Polymorphic payload block mapped explicitly to the chosen event_type.",
      "oneOf": [
        {
          "comment": "Mapped to: CLIENT_ORDER_SUBMIT",
          "properties": {
            "faction": { "type": "string", "enum": ["england", "france", "germany", "italy", "austria_hungary", "russia", "turkey"] },
            "game_year": { "type": "integer", "minimum": 1901 },
            "game_season": { "type": "string", "enum": ["Spring", "Fall", "Winter"] },
            "orders": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["unit_type", "current_location", "action"],
                "properties": {
                  "unit_type": { "type": "string", "enum": ["Army", "Fleet"] },
                  "current_location": { "type": "string", "description": "Three-letter code, e.g., 'KIE'" },
                  "current_coast": { "type": "string", "enum": ["nc", "sc", null] },
                  "action": { "type": "string", "enum": ["HOLD", "MOVE", "SUPPORT_HOLD", "SUPPORT_MOVE", "CONVOY"] },
                  "target_destination": { "type": "string", "description": "Required for MOVE, SUPPORT_MOVE, and CONVOY." },
                  "target_coast": { "type": "string", "enum": ["nc", "sc", null] },
                  "supported_unit_location": { "type": "string", "description": "Required for SUPPORT orders." }
                }
              }
            }
          }
        },
        {
          "comment": "Mapped to: SERVER_STATE_SYNC",
          "properties": {
            "current_phase": { "type": "string", "enum": ["Spring_Negotiation", "Spring_Retreats", "Fall_Negotiation", "Fall_Retreats", "Winter_Adjustment"] },
            "seconds_remaining": { "type": "integer" },
            "active_units": {
              "type": "object",
              "description": "Key-value indexing of map nodes to active units for real-time client renders.",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "faction": { "type": "string" },
                  "type": { "type": "string", "enum": ["Army", "Fleet"] },
                  "coast": { "type": "string", "enum": ["nc", "sc", null] },
                  "order_status": { "type": "string", "enum": ["PENDING", "SUBMITTED", "NONE"] }
                }
              }
            },
            "supply_center_ownership": {
              "type": "object",
              "additionalProperties": { "type": "string", "description": "Maps Center ID to owning faction name." }
            },
            "historical_resolution_logs": {
              "type": "array",
              "description": "Array of strings detailing the explicit outcomes of the prior phase execution.",
              "items": { "type": "string" }
            }
          }
        },
        {
          "comment": "Mapped to: CLIENT_CHAT_SEND or SERVER_CHAT_BROADCAST",
          "properties": {
            "sender_faction": { "type": "string" },
            "recipient_channel": { "type": "string", "description": "Can be 'GLOBAL', or a comma-separated pairing for confidential micro-alliances like 'france,germany'." },
            "message_body": { "type": "string", "maxLength": 2048 }
          }
        }
      ]
    }
  }
}

